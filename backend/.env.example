# Server Configuration
NODE_ENV=development
PORT=5000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database (Turso / libSQL)
# Set both for production so data survives restarts/redeploys.
# Leave both unset for local dev (falls back to backend/renewal-radar.db file).
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Email Configuration (Gmail Setup)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-from-gmail
EMAIL_FROM=noreply@renewalradar.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Demo account (seeded on startup)
DEMO_EMAIL=demo@renewalradar.com
DEMO_PASSWORD=Demo12345

# Optional: Use Mailtrap for development
# EMAIL_HOST=live.smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-mailtrap-username
# EMAIL_PASSWORD=your-mailtrap-password

